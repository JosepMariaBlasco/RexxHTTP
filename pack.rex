/* --------------------------------------------------------------------- */
/* Line-ending guard. Every editable source in the tree must be LF-only. */
/* RexxHTTP.rex is the hard case -- Apache execs it directly through its  */
/* "#!/usr/bin/env rexx" shebang, and a CR would break it -- but the      */
/* whole tree is LF by policy, so we check them all, not just one.        */
/*                                                                       */
/* Excluded, with reason: *.svg are generated by ebnf2svg with CRLF on    */
/* purpose (inert in DocBook/FOP); *.css and *.js are refreshed here from */
/* the Parser and carry its endings; *.pdf is binary; *.zip and *trace.xml*/
/* are build output, not source; pack.rex excludes itself (as it does     */
/* from the archive). Everything else -- including the extensionless      */
/* rexxlet fixtures and LICENSE -- must be LF.                            */
/* --------------------------------------------------------------------- */
crlfOffenders = .Array~new
Call SysFileTree ".", "allFiles.", "FOS"
Do i = 1 To allFiles.0
  path = allFiles.i
  -- Normalise the separator so the checks below are OS-agnostic.
  path = path~changeStr("\", "/")
  If path~caselessEndsWith(".svg")   Then Iterate
  If path~caselessEndsWith(".css")   Then Iterate
  If path~caselessEndsWith(".js")    Then Iterate
  If path~caselessEndsWith(".pdf")   Then Iterate
  If path~caselessEndsWith(".zip")   Then Iterate
  If path~caselessEndsWith("trace.xml") Then Iterate
  If path~caselessEndsWith("/pack.rex") Then Iterate
  If path~caselessContains("/.git/") Then Iterate
  If Pos("0d"X, .File~readChars(path)) > 0 Then
    crlfOffenders~append(path)
End

If crlfOffenders~items > 0 Then Do
  Say "ERROR:" crlfOffenders~items "file(s) contain CR (CRLF or mixed);"
  Say "       the tree is LF-only. Convert these to LF and re-pack:"
  Do offender Over crlfOffenders
    Say "         " offender
  End
  Say "Aborting."
  Exit 1
End

Parse Arg version .
date = date(s)

/* --------------------------------------------------------------------- */
/* Where the Rexx Parser lives. It is the source of truth for the        */
/* rexx-*.css stylesheets: the copies versioned in this tree are         */
/* refreshed from it on every pack, so they never drift from the         */
/* highlighter they belong to.                                           */
/*                                                                       */
/* We locate it with ParserBin(), the SAME routine the installers use to */
/* freeze the Parser into Apache's REXX_PATH. This used to be a private  */
/* search here (REXX_PARSER_DIR, falling back to ../rexx-parser) anchored */
/* on bin/highlight.rex -- a second, divergent convention: the Parser     */
/* could be found by pack and NOT by the installer, or the reverse, so    */
/* the stylesheets shipped and the highlighting actually enabled at       */
/* runtime could disagree. ParserBin anchors on Rexx.Parser.cls, which    */
/* shares bin/ with highlight.rex, and searches cwd -> REXX_PATH -> PATH  */
/* plus a ../rexx-parser sibling. One convention, one answer.             */
/* --------------------------------------------------------------------- */
parserBin = ParserBin(Directory())

If parserBin == "" Then Do
  Say "WARNING: Rexx Parser not found (looked in the current directory,"
  Say "         REXX_PATH, PATH, and ../rexx-parser)."
  Say "         rexx-*.css stylesheets and js/style-chooser.js NOT refreshed"
  Say "         this pack: the copies already versioned in css/ and js/ travel"
  Say "         as they are."
End
Else Do
  -- Copy the rexx-*.css stylesheets into the distribution so the set travels
  -- with us. The client-side style chooser (js/style-chooser.js) lazy-loads all
  -- but rexx-dark.css, but every sheet offered must be present to be picked.
  -- rexx-test1.css is a Parser development fixture, not a real theme, so it is
  -- excluded.
  --
  -- ParserBin returns the Parser's bin/; the stylesheets live in its sibling
  -- css/, hence the "/../css".
  cssDir = parserBin"/../css"
  Call SysMkDir "css"
  cssCopied = 0
  Call SysFileTree cssDir"/rexx-*.css", "cssFiles.", "FO"
  Do i = 1 To cssFiles.0
    base = FileSpec("Name", cssFiles.i)
    If base == "rexx-test1.css" Then Iterate   -- dev fixture, not a theme
    Call SysFileCopy cssFiles.i, "css/"base
    cssCopied = cssCopied + 1
  End
  If cssCopied > 0 Then
    Say "copied" cssCopied "rexx-*.css stylesheets to css/ (from" cssDir")"
  Else
    Say "WARNING: no rexx-*.css stylesheets found under" cssDir

  -- The style chooser belongs to the Parser too, and is refreshed the same way
  -- for the same reason: the copy shipped here must not drift from the token
  -- markup the highlighter emits. It lives in the Parser's js/, sibling to css/.
  jsSrc = parserBin"/../js/style-chooser.js"
  Call SysMkDir "js"
  If .File~new(jsSrc)~exists Then Do
    Call SysFileCopy jsSrc, "js/style-chooser.js"
    Say "copied style-chooser.js to js/ (from" parserBin"/../js)"
  End
  Else
    Say "WARNING: style-chooser.js not found under" parserBin"/../js"
End

/* --------------------------------------------------------------------- */
/* Package                                                               */
/* --------------------------------------------------------------------- */
zip1     = "rexxhttp-"version"-"date".zip"
zip2     = "rexxhttp-latest.zip"
"del rexxhttp-latest.zip"
"del rexxhttp-*-*.zip"
-- pack.rex is my own build utility, not part of what users download, so it
-- leaves itself out of the archive. Note the exclusion has NO wildcard: it
-- matches the pack.rex at the archive root and would spare any pack.rex
-- living deeper in the tree.
--
-- agents.md is NOT excluded, on purpose -- the asymmetry is deliberate.
-- What disqualifies pack.rex is that it does not WORK outside my setup:
-- it expects the Parser as a sibling and a git working tree, so whoever
-- unzips it cannot rebuild anything with it. agents.md is just text: it
-- reads fine anywhere, and it is exactly what someone who downloaded the
-- zip meaning to contribute would want, without having cloned yet. Note
-- this is about the ARCHIVE only: HtdocsExclude still keeps agents.md out
-- of the installed document root, which is a separate question -- shipping
-- a file to whoever opens the zip is not the same as serving it on the
-- user's web site.
"zip -r" zip1 "* -x *trace.xml *.zip pack.rex"
"zip -r" zip2 "* -x *trace.xml *.zip pack.rex"

::Requires "install/InstallHelpers.cls"   -- for ParserBin
