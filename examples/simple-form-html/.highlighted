<pre><code lineNo="1"><span class="rx-env">.response</span><span class="rx-op">~</span><span class="rx-const rx-method">content_type</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-str rx-oquo">'</span><span class="rx-str">text/html; charset=utf-8</span><span class="rx-str rx-cquo">'</span></code>
