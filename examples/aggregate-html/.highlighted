<code lineno="17"></code>
<code lineno="18"><span class="rx-kw">Do</span><span class="rx-ws"> </span><span class="rx-var">id</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-int rx-ipart">1</span><span class="rx-ws"> </span><span class="rx-skw">To</span><span class="rx-ws"> </span><span class="rx-int rx-ipart">2</span></code>
<code lineno="19"><span class="rx-ws">  </span><span class="rx-var">post</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-const rx-int-func">FetchJSON</span><span class="rx-spe">(</span><span class="rx-var">Base</span><span class="rx-ws"> </span><span class="rx-op">|</span><span class="rx-op">|</span><span class="rx-ws"> </span><span class="rx-var">id</span><span class="rx-spe">)</span></code>
<code lineno="20"><span class="rx-ws">  </span><span class="rx-kw">If</span><span class="rx-ws"> </span><span class="rx-var">post</span><span class="rx-ws"> </span><span class="rx-op">=</span><span class="rx-op">=</span><span class="rx-ws"> </span><span class="rx-env">.nil</span><span class="rx-ws"> </span><span class="rx-kw">Then</span></code>
<code lineno="21"><span class="rx-ws">    </span><span class="rx-kw">Say</span><span class="rx-ws"> </span><span class="rx-str rx-oquo">'</span><span class="rx-str">    &lt;p&gt;Could not load post </span><span class="rx-str rx-cquo">'</span><span class="rx-var">id</span><span class="rx-str rx-oquo">'</span><span class="rx-str">.&lt;/p&gt;</span><span class="rx-str rx-cquo">'</span></code>
