<code lineno="36"></code>
<code lineno="37"><span class="rx-lncm">-- Fetch a URL and parse the JSON body into a Rexx object.</span></code>
<code lineno="38"><span class="rx-lncm">-- Returns .nil if the download fails or the body is not valid JSON.</span></code>
<code lineno="39"><span class="rx-lncm">-- Note: this blocks the CGI process until curl returns, so we keep it</span></code>
<code lineno="40"><span class="rx-lncm">-- on a short leash -- --connect-timeout caps the connect phase at 5s,</span></code>
<code lineno="41"><span class="rx-lncm">-- and --max-time caps the whole transfer at 15s, so a dead remote host</span></code>
<code lineno="42"><span class="rx-lncm">-- cannot hang the request. -f makes curl return a non-zero RC on HTTP</span></code>
<code lineno="43"><span class="rx-lncm">-- &gt;= 400 instead of handing back the error page as if it were the body.</span></code>
<code lineno="44"><span class="rx-lncm">-- curl ships with Windows 10/11, macOS and most Linux; wget does not.</span></code>
<code lineno="45"><span class="rx-const rx-label">FetchJSON</span><span class="rx-spe">:</span><span class="rx-ws"> </span><span class="rx-kw">Procedure</span></code>
<code lineno="46"><span class="rx-ws">  </span><span class="rx-kw">Use</span><span class="rx-ws"> </span><span class="rx-skw">Strict</span><span class="rx-ws"> </span><span class="rx-skw">Arg</span><span class="rx-ws"> </span><span class="rx-var">url</span></code>
<code lineno="47"></code>
<code lineno="48"><span class="rx-ws">  </span><span class="rx-kw">Address</span><span class="rx-ws"> </span><span class="rx-const rx-environment">Command</span><span class="rx-ws"> </span><span class="rx-str rx-oquo">"</span><span class="rx-str">curl -sf --connect-timeout 5 --max-time 15</span><span class="rx-str rx-cquo">"</span><span class="rx-op"> </span><span class="rx-var">url</span><span class="rx-ws"> </span><span class="rx-skw">With</span><span class="rx-ws"> </span><span class="rx-skw">Output</span><span class="rx-ws"> </span><span class="rx-skw">Stem</span><span class="rx-ws"> </span><span class="rx-stem">lines.</span></code>
<code lineno="49"><span class="rx-ws">  </span><span class="rx-kw">If</span><span class="rx-ws"> </span><span class="rx-var">RC</span><span class="rx-ws"> </span><span class="rx-op">\</span><span class="rx-op">=</span><span class="rx-ws"> </span><span class="rx-int rx-ipart">0</span><span class="rx-ws"> </span><span class="rx-kw">Then</span><span class="rx-ws"> </span><span class="rx-kw">Return</span><span class="rx-ws"> </span><span class="rx-env">.nil</span></code>
<code lineno="50"></code>
<code lineno="51"><span class="rx-ws">  </span><span class="rx-var">text</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-str rx-oquo">"</span><span class="rx-str"></span><span class="rx-str rx-cquo">"</span></code>
<code lineno="52"><span class="rx-ws">  </span><span class="rx-kw">Do</span><span class="rx-ws"> </span><span class="rx-var">i</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-int rx-ipart">1</span><span class="rx-ws"> </span><span class="rx-skw">To</span><span class="rx-ws"> </span><span class="rx-stem">lines.</span><span class="rx-int">0</span></code>
<code lineno="53"><span class="rx-ws">    </span><span class="rx-kw">If</span><span class="rx-ws"> </span><span class="rx-var">i</span><span class="rx-ws"> </span><span class="rx-op">&gt;</span><span class="rx-ws"> </span><span class="rx-int rx-ipart">1</span><span class="rx-ws"> </span><span class="rx-kw">Then</span><span class="rx-ws"> </span><span class="rx-var">text</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-var">text</span><span class="rx-ws"> </span><span class="rx-op">|</span><span class="rx-op">|</span><span class="rx-ws"> </span><span class="rx-xstr rx-oquo">"</span><span class="rx-xstr">0a</span><span class="rx-xstr rx-cquo">"</span><span class="rx-xstr rx-ssuf">x</span></code>
<code lineno="54"><span class="rx-ws">    </span><span class="rx-var">text</span><span class="rx-ws"> </span><span class="rx-asg">=</span><span class="rx-ws"> </span><span class="rx-var">text</span><span class="rx-ws"> </span><span class="rx-op">|</span><span class="rx-op">|</span><span class="rx-ws"> </span><span class="rx-stem">lines.</span><span class="rx-var">i</span></code>
<code lineno="55"><span class="rx-ws">  </span><span class="rx-kw">End</span></code>
<code lineno="56"></code>
<code lineno="57"><span class="rx-ws">  </span><span class="rx-kw">Signal</span><span class="rx-ws"> </span><span class="rx-skw">On</span><span class="rx-ws"> </span><span class="rx-skw">Syntax</span><span class="rx-ws"> </span><span class="rx-skw">Name</span><span class="rx-ws"> </span><span class="rx-const rx-label">BadJSON</span></code>
<code lineno="58"><span class="rx-ws">  </span><span class="rx-kw">Return</span><span class="rx-ws"> </span><span class="rx-env">.json</span><span class="rx-op">~</span><span class="rx-const rx-method">fromJson</span><span class="rx-spe">(</span><span class="rx-var">text</span><span class="rx-spe">)</span></code>
<code lineno="59"></code>
<code lineno="60"><span class="rx-const rx-label">BadJSON</span><span class="rx-spe">:</span></code>
<code lineno="61"><span class="rx-ws">  </span><span class="rx-kw">Return</span><span class="rx-ws"> </span><span class="rx-env">.nil</span></code>
<code lineno="62"></code>
<code lineno="63"><span class="rx-dir">::</span><span class="rx-dkw">Requires</span><span class="rx-ws"> </span><span class="rx-const rx-requires rx-oquo">"</span><span class="rx-const rx-requires">json.cls</span><span class="rx-const rx-requires rx-cquo">"</span>
</code></pre>
