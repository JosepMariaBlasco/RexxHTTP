  -- Load the page factory
 .context~package~loadPackage( .request~RexxHTTP_dir"/apps/page.cls" )

  -- We will build our page manually and feed it to the page
  -- using the ~body method

 .response~content_type = "text/html"

  body = .MutableBuffer~new
  eol  = .endOfLine

  body~append(.Resources~before~makeString)

  -- Each pair is (directory, link title). The titles follow the naming
  -- scheme that makes explicit what every example returns.
  Loop pair Over -
    ("hello-world-plain",         'Greeting the world &mdash; returning plain text'),               -
    ("hello-world-html",          'Greeting the world &mdash; returning HTML'),                      -
    ("hello-world-unicode-plain", 'Greeting the world with Unicode &mdash; returning plain text'),   -
    ("hello-world-unicode-html",  'Greeting the world with Unicode &mdash; returning HTML'),         -
    ("simple-form-html",          'Reading a HTML GET form'),                                        -
    ("simple-cookie-html",        'Setting, reading and resetting a cookie'),                        -
    ("aggregate-json",            'Fetching and merging JSON from the web &mdash; returning JSON'),  -
    ("aggregate-html",            'Fetching and merging JSON from the web &mdash; returning HTML')

    directory  = pair[1]
    linkTitle  = pair[2]
    hlFile     = directory"/.highlighted"
    -- The pre-rendered source is produced at pack time by the Rexx Parser
    -- and shipped alongside each index.rxl. When present, offer the source in
    -- a collapsible <details>; when absent (a build without the Parser),
    -- just list the example, so the page works standalone.
    If SysFileExists(hlFile) Then entry = -
      '      <li>',                       -
      '<details>',                        -
      "<summary><span class='arrow' title='Press to see the source'></span> <a href='"directory"/'>"linkTitle"</a></summary>", -
     .File~readChars(hlFile),             -
      '</details>',                       -
      '      </li>'
    Else entry = "      <li><a href='"directory"/'>"linkTitle"</a></li>"
    body~append(entry~makeString,eol)
  End

  body~append(.Resources~after~makeString)

 .Page~new("RexxHTTP examples")~body(body~string)~done

  Exit


--------------------------------------------------------------------------------
-- We add a little CSS for the collapsible source blocks: hide the default
-- marker and use a rotating arrow instead. It is specific to this page,
-- so it lives here rather than in the shared stylesheet. (The syntax
-- colours themselves come from rexx-dark.css, linked by page.cls.)
::Resource before
    <style>
      details > summary { list-style: none; cursor: pointer; }
      details > summary::-webkit-details-marker { display: none; }
      details > summary .arrow::before { content: "\25B6"; margin-right: .4em; color: var(--marron); }
      details[open] > summary .arrow::before { content: "\25BC"; }
      details { margin: .4rem 0; }
    </style>

    <p class="rotulo">Examples</p>

    <h1>RexxHTTP examples</h1>
    <p class="intro">
      Each of these is a small rexxlet. Follow a link
      to see it run, or open the arrow to read its source.
    </p>

    <ol>
::END

::Resource after
    </ol>
::END