#!/usr/bin/env rexx
/******************************************************************************/
/*                                                                            */
/* Linux.install - Installer for RexxHTTP on Debian/Ubuntu Linux (and WSL)    */
/* =======================================================================    */
/*                                                                            */
/* This file is part of the RexxHTTP package                                  */
/* [See https://rexx.epbcn.com/rexxhttp/]                                     */
/*                                                                            */
/* Copyright (c) 2006-2026 Josep Maria Blasco <josep.maria.blasco@epbcn.com>  */
/*                                                                            */
/* License: Apache License 2.0 (https://www.apache.org/licenses/LICENSE-2.0)  */
/*                                                                            */
/* Installs RexxHTTP on a CLEAN Debian/Ubuntu machine, following the recipe   */
/* of the manual's Installation chapter: it installs Apache 2.4 with the      */
/* cgid and actions modules, deploys the six source files to the standard     */
/* cgi-bin, drops in the rexxhttp.conf fragment, plants a minimal index       */
/* rexxlet in the document root, and smoke-tests the whole montage with curl. */
/*                                                                            */
/* This first version targets the CLEAN-MACHINE case. If it finds Apache      */
/* already present, it STOPS and does nothing, rather than risk touching a    */
/* server the user set up for something else. Reusing or extending an         */
/* existing Apache is left for a later iteration.                             */
/*                                                                            */
/* It is independent of the test runner (tests/http/RunHTTPTests.rex): the    */
/* runner builds a throwaway test montage and tears it down; this installer   */
/* materialises the manual's production recipe and leaves it in place.        */
/*                                                                            */
/* This script targets Linux (Debian/Ubuntu, including WSL): it uses apt-get  */
/* and the Apache paths specific to Debian/Ubuntu.                            */
/*                                                                            */
/* Version history:                                                           */
/*                                                                            */
/* Date     Version Details                                                   */
/* -------- ------- --------------------------------------------------------- */
/* 20260630    1.0  First version.                                            */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- Locate the sources (src/ is a sibling of this install/ directory)          --
--------------------------------------------------------------------------------

  sep = .File~separator
  -- The package root is the parent of this install/ directory; src/ is its
  -- child. srcRoot feeds the exclusion-model htdocs population (PlantHtdocs).
  srcRoot = .File~new(.Context~package~name)~parentFile~parent
  srcDir  = srcRoot || sep"src"

  -- The five files that make up a Unix installation. Apache execs
  -- RexxHTTP.rex directly via its LF "#!/usr/bin/env rexx" shebang; there is
  -- no wrapper (RexxHTTP.rex must be LF, which pack.rex enforces at build).
  sources = "HTTP.Request.cls HTTP.Response.cls HTTP.OutputStream.cls" -
            "HTTP.Cookie.cls RexxHTTP.rex"

  -- Deployment locations on Debian/Ubuntu. cgi-bin is already aliased as
  -- executable CGI by the prepackaged Apache, so no ScriptAlias of our own.
  cgiBinDir = "/usr/lib/cgi-bin"
  docRoot   = "/var/www/html"
  confFile  = "/etc/apache2/conf-available/rexxhttp.conf"

--------------------------------------------------------------------------------
-- Options come pre-parsed and sanitized from the driver (install/uninstall)  --
-- as a Directory; this script does no argument parsing of its own.           --
--------------------------------------------------------------------------------

  Use Strict Arg opts
  assumeYes  = opts~assumeYes
  uninstall  = (opts~mode == "uninstall")
  keepApache = opts~keepApache

  -- The Apache Listen port. Debian/Ubuntu's apache2 package ships
  -- /etc/apache2/ports.conf with "Listen 80", so 80 is the default; --port
  -- overrides it (e.g. when 80 is already taken by nginx or another server).
  -- The uninstall needs it too, but reads it from the manifest -- see Uninstall.
  If opts~port \== "" Then port = opts~port
                      Else port = 80

  If uninstall Then
    Return Uninstall(assumeYes, keepApache, -
                     cgiBinDir, docRoot, confFile, sources)

  Say
  Say "RexxHTTP Installer for Debian/Ubuntu Linux"
  Say "==========================================="
  Say
  Say "Sources directory:" srcDir
  Say

--------------------------------------------------------------------------------
-- Step 1: Require apt-get (Debian/Ubuntu family)                             --
--------------------------------------------------------------------------------

  Say "Checking for apt-get (Debian/Ubuntu family)..."
  Address System "which apt-get > /dev/null 2>&1"
  If RC \== 0 Then Do
    Say "  ERROR: apt-get not found. This installer targets the Debian/Ubuntu"
    Say "  family. On other distributions, install Apache 2.4 with the cgid and"
    Say "  actions modules by hand, then follow the manual's recipe."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 2: Check ooRexx (installing it is out of scope, per the manual)       --
--------------------------------------------------------------------------------

  Say "Checking ooRexx..."
  Address System "rexx -v > /dev/null 2>&1"
  If RC \== 0 Then Do
    Say "  ERROR: ooRexx is not installed or not in PATH."
    Say "  RexxHTTP needs ooRexx 5.3.0 r13572 or later. Install it first, from the"
    Say "  Open Object Rexx project: https://sourceforge.net/projects/oorexx/"
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 3: Stop if Apache is already present (clean-machine policy)           --
--------------------------------------------------------------------------------

  Say "Checking that Apache is NOT already installed..."
  Address System "which apache2 apachectl > /dev/null 2>&1"
  apacheBin = (RC == 0)
  Address System "test -d /etc/apache2"
  apacheConf = (RC == 0)

  If apacheBin | apacheConf Then Do
    Say
    Say "  STOP: Apache appears to be already installed on this machine"
    If apacheBin  Then Say "        (found the apache2/apachectl binary)"
    If apacheConf Then Say "        (found the /etc/apache2 configuration tree)"
    Say
    Say "  This first version of the installer only operates on a clean machine:"
    Say "  it installs Apache itself and will not touch a server that is already"
    Say "  here, to avoid disturbing a setup made for something else."
    Say
    Say "  Nothing was changed. To install RexxHTTP onto this existing Apache,"
    Say "  follow the recipe in the manual's Installation chapter by hand."
    Return 1
  End

  -- Beyond an apt-installed Apache, refuse if anything else already holds the
  -- TCP port we are about to use (a hand-built Apache, nginx, whatever): we
  -- would put Apache on it too, and they cannot share it. ss is the modern
  -- tool; if it is missing or silent we do not block on a guess -- the checks
  -- above already cover the common case. Local address is ss's 4th column; the
  -- port follows its last colon, which is also correct for IPv6 forms like
  -- [::]:80. The port is 80 by default or whatever --port set; if it is busy we
  -- stop and point at the --port way out.
  portInUse = .Array~new
  Address System "ss -ltn 2>/dev/null" With Output Using (portInUse) Error Using (.Array~new)
  Do line Over portInUse
    If \line~word(1)~caselessEquals("LISTEN") Then Iterate
    localAddr = line~word(4)
    colon = localAddr~lastPos(":")
    If colon == 0 Then Iterate
    If localAddr~substr(colon + 1) == port Then Do
      Say
      Say "  STOP:" PortBusyMsg(port)
      Say "  Nothing was changed."
      Return 1
    End
  End

  Say "  OK (clean machine)."

--------------------------------------------------------------------------------
-- Step 4: Confirm before making changes                                      --
--------------------------------------------------------------------------------

  Say
  Say "About to install, as root (sudo):"
  Say "  - Apache 2.4 (apt-get install apache2), with cgid + actions enabled"
  Say "  - RexxHTTP sources -> " || cgiBinDir
  Say "  - config fragment  -> " || confFile
  Say "  - then smoke-test the landing page at http://localhost/"
  Say
  If \assumeYes Then
    If \Ask("Proceed?") Then Do
      Say "Aborted. Nothing was changed."
      Return 1
    End

--------------------------------------------------------------------------------
-- Step 5: Install Apache + enable modules                                    --
--------------------------------------------------------------------------------

  Say
  Say "Installing Apache..."
  Address System "sudo apt-get update -qq && sudo apt-get install -y -qq apache2 2>&1"
  If RC \== 0 Then Do
    Say "  ERROR: Failed to install apache2."
    Return 1
  End
  Say "  OK."

  Say "Enabling modules (cgid, actions)..."
  Address System "sudo a2enmod cgid actions 2>&1"
  If RC \== 0 Then Do
    Say "  ERROR: Failed to enable cgid/actions."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 6: Deploy the six sources to cgi-bin                                  --
--------------------------------------------------------------------------------

  Say "Deploying sources to" cgiBinDir"..."
  Address System "sudo mkdir -p" cgiBinDir
  Do src Over sources~makeArray(" ")
    Address System "sudo cp" '"'srcDir || sep || src'"' cgiBinDir
    If RC \== 0 Then Do
      Say "  ERROR: Failed to copy" src
      Return 1
    End
  End
  -- RexxHTTP.rex must be executable; Apache will not run a CGI it cannot exec.
  Address System "sudo chmod +x" cgiBinDir"/RexxHTTP.rex"

  -- Apache runs CGIs with a minimal PATH that need not contain rexx (on a
  -- self-built ooRexx it usually does not). RexxHTTP.rex ships with a
  -- "#!/usr/bin/env rexx" shebang, which fails when env cannot find rexx on
  -- that PATH. Pin the shebang to the absolute rexx we are running under, so
  -- the deployed processor does not depend on Apache's PATH. We rewrite only
  -- the copy in cgi-bin, never the canonical source.
  Call PinShebang cgiBinDir"/RexxHTTP.rex"
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 7: Drop in the rexxhttp.conf fragment and enable it                   --
--------------------------------------------------------------------------------

  Say "Writing config fragment" confFile"..."
  tmpConf = MakeTempFile("rexxhttp.conf")
  If tmpConf == "" Then Do
    Say "  ERROR: Could not create a temporary file."
    Return 1
  End
  conf = .Resources~RexxHTTPConf~makeString("L", "0A"x)
  -- Splice in the install-time SetEnv lines (see the %SETENV% marker in the
  -- ::Resource); RexxHTTPSetEnvLines documents which variables are emitted.
  -- docRoot is the installation root the whole package was planted under.
  conf = conf~changeStr("%SETENV%", RexxHTTPSetEnvLines(docRoot, "    ")~strip("T", .endOfLine))
  Call Stream tmpConf, "C", "Open Write Replace"
  Call CharOut tmpConf, conf
  Call Stream tmpConf, "C", "Close"
  -- install(1), not cp: the temp file is mode 600 (see MakeTempFile) and this
  -- destination is created by us, so a plain cp would leave Apache's config
  -- unreadable to anyone but root. -m 644 states the mode we actually want.
  Address System "sudo install -m 644" tmpConf confFile
  Address System "rm -f" tmpConf
  Address System "sudo a2enconf rexxhttp > /dev/null 2>&1"
  If RC \== 0 Then Do
    Say "  ERROR: Failed to enable the rexxhttp config."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 7b: Set the Listen port when --port asked for a non-default one        --
--------------------------------------------------------------------------------
-- On Debian/Ubuntu the Listen directive lives in /etc/apache2/ports.conf (from
-- the apache2 package), not in our fragment. When the user asked for a port
-- other than 80 we rewrite that file's "Listen 80" in place -- rather than
-- adding a second Listen, which would leave Apache trying port 80 as well. The
-- file is root-owned, so we edit a temp copy and sudo-install it. The port is
-- recorded in the manifest (below) so the uninstall can put it back.

  If port \== 80 Then Do
    Say "Setting Apache to listen on port" port "(/etc/apache2/ports.conf)..."
    portsConf = "/etc/apache2/ports.conf"
    tmpPorts  = MakeTempFile("rexxhttp-ports")
    If tmpPorts == "" Then Do
      Say "  ERROR: Could not create a temporary file."
      Return 1
    End
    -- cp, not install -m: ports.conf already exists and belongs to the apache2
    -- package, so cp keeps the destination's own mode and we leave it as we
    -- found it. (Only destinations we create need an explicit mode.)
    -- Read the current ports.conf (world-readable), rewrite any bare "Listen
    -- 80" or "Listen addr:80" to our port, and sudo-install the result.
    lines = .Array~new
    Do While Lines(portsConf) > 0
      line = LineIn(portsConf)
      -- Rewrite only the Listen whose port is 80 (the one we are changing).
      -- ports.conf also carries "Listen 443" inside <IfModule ssl> guards; those
      -- must stay untouched, so we match the port, not just the "Listen" keyword.
      If line~strip~caselessAbbrev("Listen") Then Do
        stripped = line~strip
        Parse Var stripped . spec .
        colon = spec~lastPos(":")
        If colon > 0 Then linePort = spec~substr(colon + 1)
                     Else linePort = spec
        If linePort == 80 Then line = RewriteListen(line, port)
      End
      lines~append(line)
    End
    Call Stream portsConf, "C", "Close"
    Call Stream tmpPorts, "C", "Open Write Replace"
    Do line Over lines
      Call LineOut tmpPorts, line
    End
    Call Stream tmpPorts, "C", "Close"
    Address System "sudo cp" tmpPorts portsConf
    Address System "rm -f" tmpPorts
    Say "  OK."
  End

--------------------------------------------------------------------------------
-- Step 8: Populate the document root (exclusion model)                       --
--------------------------------------------------------------------------------
-- Instead of enumerating what to deploy, copy the WHOLE package into htdocs
-- and leave out only the scaffolding (see HtdocsExclude): install/, tests/,
-- and the repo-only files (pack.rex, .gitattributes, agents.md), which are
-- present when installing from a git clone and absent from the published zip. Everything else becomes the
-- browsable sample web: the root index rexxlet, bin/ (page factory + the two
-- action rexxlets), the stylesheets,
-- the examples/ tree (sources highlighted on request by the viewer), src/ as a
-- readable copy, the manual PDF, readme.md and LICENSE. The AddHandler in the
-- conf fragment runs only *.rxl files as rexxlets, so every .cls/.rex/.md
-- copied here is served as text, never executed -- exactly what "a web to
-- tinker with" wants. src/ additionally lives in cgi-bin (Step
-- 6), where it executes: same folder, two destinations.
--
-- PlantHtdocs returns the manifest of planted files (paths relative to the
-- document root); it is recorded in the management directory below so the
-- uninstall retires exactly what was planted and nothing of the operator's.

  Say "Populating" docRoot "from the package (exclusion model)..."
  planted = PlantHtdocs(srcRoot, docRoot, "sudo")
  Say "  OK." planted~items "files planted."

--------------------------------------------------------------------------------
-- Step 9: Restart Apache to pick everything up                               --
--------------------------------------------------------------------------------

  Say "Restarting Apache..."
  Address System "sudo systemctl restart apache2 2>/dev/null"
  If RC \== 0 Then
    -- Fall back to apachectl where systemd is not the init (e.g. plain WSL).
    Address System "sudo apachectl restart 2>/dev/null"
  Call SysSleep 0.5
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 9b: Deploy the management directory (self-sufficient uninstall)        --
--------------------------------------------------------------------------------
-- Copy the six install/ files to a stable location and write a manifest, so
-- uninstall still exists -- and knows what to undo -- after the download is
-- deleted. Done before the smoke test, not as a reward for it: even if the
-- smoke test fails, the user must be able to uninstall and clean up. On Linux
-- the manifest carries no path the uninstall could not recompute (the layout
-- is fixed), but it is written anyway for uniformity across platforms.

  mgmtDir = ManagementDir("Linux")
  Say "Installing the uninstaller to" mgmtDir"..."
  installDir = .File~new(.Context~package~name)~parentFile~absolutePath
  Address System "sudo mkdir -p" mgmtDir
  Do f Over ManagementFiles()~makeArray(" ")
    Address System "sudo cp" '"'installDir || sep || f'"' '"'mgmtDir || "/" || f'"'
    If RC \== 0 Then Do
      Say "  WARNING: could not copy" f "to" mgmtDir"."
      Say "  The install itself is fine, but 'rexx uninstall' will not be"
      Say "  available from a stable location. You can still uninstall from"
      Say "  this download directory."
      Leave
    End
  End
  -- Manifest to a temp file, then sudo-cp it into the root-owned mgmt dir.
  tmpManifest = MakeTempFile("rexxhttp-manifest")
  If tmpManifest == "" Then Do
    Say "  ERROR: Could not create a temporary file."
    Return 1
  End
  -- Record the port only when we changed it from 80; on a default install
  -- there is nothing for the uninstall to restore in ports.conf.
  If port == 80 Then manifestPort = ""
                Else manifestPort = port
  Call WriteManifest tmpManifest, "", manifestPort   -- Linux: no serverRoot to record
  -- install -m 644, not cp: we create this file, and cp would carry over the
  -- temp file's 600. The manifest is read back by the uninstall.
  Address System "sudo install -m 644" tmpManifest '"'ManifestPath("Linux", mgmtDir)'"'
  Address System "rm -f" tmpManifest

  -- The htdocs manifest: the list of files planted in the document root under
  -- the exclusion model, so the uninstall retires exactly those and leaves any
  -- operator files untouched (the coexist-safe path). Same temp-then-sudo-cp
  -- dance into the root-owned management directory.
  tmpHtdocs = MakeTempFile("rexxhttp-htdocs-manifest")
  If tmpHtdocs == "" Then Do
    Say "  ERROR: Could not create a temporary file."
    Return 1
  End
  Call WriteHtdocsManifest tmpHtdocs, planted
  Address System "sudo install -m 644" tmpHtdocs '"'HtdocsManifestPath("Linux", mgmtDir)'"'
  Address System "rm -f" tmpHtdocs
  Say "  OK."


--------------------------------------------------------------------------------
-- Step 10: Smoke test                                                        --
--------------------------------------------------------------------------------

  -- The base URL for the smoke test and messages. Port 80 is implicit
  -- (http://localhost/); any other port is spelled out (http://localhost:NNNN/).
  If port == 80 Then baseUrl = "http://localhost"
                Else baseUrl = "http://localhost:"port

  Say "Smoke test (curl" baseUrl"/)..."
  out = .Array~new
  Address System "curl -s --noproxy localhost" baseUrl"/" -
    With Output Using (out) Error Using (.Array~new)
  body = ""
  Do l Over out
    body = body || l
  End

  Say
  If body~caselessContains("RexxHTTP") Then Do
    Say "============================================================"
    Say " SUCCESS: a minimal RexxHTTP installation is up and running."
    Say "============================================================"
    Say
    Say " Open it in a browser at:  " || baseUrl"/"
    Say " or from the command line:  curl" baseUrl"/"
    Say
    Say " The welcome page links to a set of example rexxlets you can"
    Say " explore. They are small Rexx programs; follow a link to see"
    Say " each one run."
    Say
    Say " You can find a copy of the RexxHTTP documentation at:"
    Say "   https://rexx.epbcn.com/rexxhttp/"
    Say " and at:"
    Say "   " || baseUrl"/"
    Say
    Return 0
  End
  Else Do
    Say "============================================================"
    Say " WARNING: install finished, but the smoke test did not return"
    Say " the expected output. " || baseUrl"/ returned:"
    Say "   " || body~strip~left(200)
    Say " Check /var/log/apache2/error.log and the config fragment."
    Say "============================================================"
    Return 1
  End

/******************************************************************************/
/* Uninstall: remove what the installer put here. By default this is          */
/* symmetric with the clean-machine install -- it also removes Apache,        */
/* returning the machine to its pre-install state. With keepApache it retires  */
/* ONLY RexxHTTP (fragment + Include + sources + index), leaving Apache: the   */
/* "coexist" path, where RexxHTTP was a guest on someone else's Apache.        */
/******************************************************************************/
Uninstall: Procedure
  Use Strict Arg assumeYes, keepApache, cgiBinDir, docRoot, confFile, sources

  Say
  Say "RexxHTTP Uninstaller for Debian/Ubuntu Linux"
  Say "============================================="
  Say

  -- Nothing to do if there is no Apache config tree at all.
  Address System "test -d /etc/apache2"
  If RC \== 0 Then Do
    Say "Apache does not appear to be installed (no /etc/apache2)."
    Say "Nothing to uninstall."
    Return 0
  End

  Say "About to remove, as root (sudo):"
  Say "  - the RexxHTTP config fragment ("confFile") and disable it"
  Say "  - the RexxHTTP sources from" cgiBinDir
  Say "  - the files RexxHTTP planted in" docRoot "(per the install manifest)"
  If \keepApache Then
    Say "  - Apache itself (apt-get purge apache2*), to undo the install"
  Else
    Say "  - (Apache is kept: --keep-apache)"
  Say
  If \assumeYes Then
    If \Ask("Proceed?") Then Do
      Say "Aborted. Nothing was changed."
      Return 1
    End

  -- 1. Disable and delete the config fragment.
  Say
  Say "Disabling and removing the config fragment..."
  Address System "sudo a2disconf rexxhttp > /dev/null 2>&1"
  Address System "sudo rm -f" confFile
  Say "  OK."

  -- 2. Remove the deployed sources from cgi-bin.
  Say "Removing sources from" cgiBinDir"..."
  Do src Over sources~makeArray(" ")
    Address System "sudo rm -f" cgiBinDir"/"src
  End
  Say "  OK."

  -- 3. Remove everything the installer planted in htdocs, and nothing else.
  -- Read the htdocs manifest written at install time and retire exactly those
  -- files, pruning the directories they leave empty. Operator files (and the
  -- directories that still hold them) are left untouched -- the coexist-safe
  -- behaviour that matters on the --keep-apache path. If the manifest is
  -- missing (an install predating the exclusion model), there is nothing to
  -- walk and the step is a no-op.
  mgmtDir = ManagementDir("Linux")
  planted = ReadHtdocsManifest(HtdocsManifestPath("Linux", mgmtDir))
  Say "Removing" planted~items "planted files from" docRoot"..."
  Call UnplantHtdocs docRoot, planted, "sudo"
  Say "  OK."

  -- The port the install recorded, if it changed it from 80. Empty means the
  -- install used the default, so there is no ports.conf Listen to restore.
  manifestPort = ReadManifestPort(ManifestPath("Linux", mgmtDir))

  If keepApache Then Do
    -- If the install changed the Listen port, put ports.conf back to 80 so the
    -- operator's Apache is left exactly as it was before RexxHTTP. Only the
    -- manifest knows we changed it. (On the symmetric path below Apache is
    -- purged, ports.conf included, so there is nothing to restore there.)
    If manifestPort \== "", manifestPort \== 80 Then Do
      Say "Restoring Apache's Listen port to 80 (/etc/apache2/ports.conf)..."
      portsConf = "/etc/apache2/ports.conf"
      tmpPorts  = MakeTempFile("rexxhttp-ports")
      -- Unlike the install, a failure here must not abort: the uninstall is
      -- already under way and stopping would leave the system half-retired.
      -- Warn, skip the port restore, and carry on with the rest.
      If tmpPorts == "" Then Do
        Say "  WARNING: Could not create a temporary file; leaving the Listen"
        Say "  port as it is. Restore it by hand in" portsConf"."
      End
      Else Do
      lines = .Array~new
      Do While Lines(portsConf) > 0
        line = LineIn(portsConf)
        If line~strip~caselessAbbrev("Listen") Then Do
          stripped = line~strip
          Parse Var stripped . spec .
          colon = spec~lastPos(":")
          If colon > 0 Then linePort = spec~substr(colon + 1)
                       Else linePort = spec
          If linePort == manifestPort Then line = RewriteListen(line, 80)
        End
        lines~append(line)
      End
      Call Stream portsConf, "C", "Close"
      Call Stream tmpPorts, "C", "Open Write Replace"
      Do line Over lines
        Call LineOut tmpPorts, line
      End
      Call Stream tmpPorts, "C", "Close"
      Address System "sudo cp" tmpPorts portsConf
      Address System "rm -f" tmpPorts
      Say "  OK."
      End
    End

    -- Coexist path: reload Apache so it forgets the handler, and stop here.
    Say "Reloading Apache (without the RexxHTTP config)..."
    Address System "sudo systemctl reload apache2 2>/dev/null"
    If RC \== 0 Then
      Address System "sudo apachectl graceful 2>/dev/null"
    Say "  OK."
    Say
    Say "============================================================"
    Say " RexxHTTP removed. Apache is still installed and running."
    Say "============================================================"

    -- Remove the management directory last: the uninstaller is running
    -- from here, but ooRexx has already tokenised these files into memory,
    -- so deleting them now is safe. This makes the removal complete.
    Address System "sudo rm -rf" ManagementDir("Linux")
    Return 0
  End

  -- 4. Symmetric uninstall: remove Apache itself, as the install added it.
  Say "Removing Apache (apt-get purge apache2*)..."
  Address System "sudo apt-get purge -y -qq 'apache2*' 2>&1"
  Address System "sudo apt-get autoremove -y -qq 2>&1"
  Say "  OK."

  Say
  Say "============================================================"
  Say " RexxHTTP and Apache removed. The machine is back to its"
  Say " pre-install state."
  Say "============================================================"

  -- Remove the management directory last (see note in the keep-apache path).
  Address System "sudo rm -rf" ManagementDir("Linux")
  Return 0

/******************************************************************************/
/* PinShebang: rewrite the deployed processor's first line from               */
/* "#!/usr/bin/env rexx" to "#!<absolute rexx>", so it does not depend on     */
/* Apache's PATH. Resolves rexx with SysSearchPath (the same rexx running     */
/* this installer). Writes via a temp file + sudo cp, since cgi-bin is root-  */
/* owned. If rexx cannot be resolved, leaves the file untouched (the          */
/* env-based shebang still works wherever Apache's PATH includes rexx).       */
/* EOL: the LineIn/LineOut rewrite re-emits every line with the platform's     */
/* native terminator. On Linux that is LF, matching the LF source pack.rex     */
/* enforces on RexxHTTP.rex, so the rewrite is byte-transparent here.          */
/******************************************************************************/
PinShebang: Procedure
  Use Strict Arg script
  rexxPath = SysSearchPath("PATH", "rexx")
  If rexxPath == "" Then Return          -- cannot resolve; leave env shebang

  -- Read the deployed script, replace only the first line if it is the
  -- env shebang, and write the result through a temp file.
  body = .Array~new
  Do While Lines(script) > 0
    body~append(LineIn(script))
  End
  Call Stream script, "C", "Close"
  If body~items == 0 Then Return
  If body[1]~strip == "#!/usr/bin/env rexx" Then
    body[1] = "#!"rexxPath

  -- The destination is the CGI Apache runs on every request, so this temp file
  -- is the most sensitive of the installer: Random(1, 99999) used to name it,
  -- which is a space small enough to enumerate in a loop and is not what
  -- ooRexx's Random is for. mktemp closes that (see MakeTempFile).
  tmp = MakeTempFile("RexxHTTP.rex")
  If tmp == "" Then Return               -- cannot stage; leave env shebang
  Do line Over body
    Call LineOut tmp, line
  End
  Call Stream tmp, "C", "Close"
  -- install -m 755 does the copy and the mode in one step: the temp file is
  -- 600, and the old "cp then chmod +x" left the read bits to whatever the
  -- destination happened to carry, with +x subject to umask. Apache runs this
  -- as www-data, so it must be readable and executable by others.
  Address System "sudo install -m 755" '"'tmp'"' '"'script'"'
  Address System "rm -f" '"'tmp'"'
  Return

/******************************************************************************/
/* Resources: the files this installer generates.                            */
/******************************************************************************/

-- The drop-in config fragment. Declares ONLY the handler and, via AddHandler,
-- treats every *.rxl file in the document root as a rexxlet, with DirectoryIndex
-- wrapper.rxl (a one-line rexxlet that Calls RexxHTTP.home.rex) so that requesting
-- the directory runs the landing page. This mirrors the manual's recipe.
::Resource RexxHTTPConf
# RexxHTTP drop-in configuration (Debian/Ubuntu).
# Installed by install/InstallLinux.rex. Enable with: a2enconf rexxhttp
#
# The handler routes a request to the processor instead of to the file the
# request names. Apache execs RexxHTTP.rex directly via its LF shebang.

# Give Apache a name so it stops emitting AH00558 ("Could not reliably
# determine the server's fully qualified domain name") at start/stop.
ServerName localhost

Action RexxHTTP /cgi-bin/RexxHTTP.rex

<Directory "/var/www/html">
    DirectoryIndex wrapper.rxl index.rxl readme.md
    # Route every *.md through the Markdown renderer at /bin/markdown.rxl: it turns
    # the file into a styled HTML page (via pandoc when present), or serves
    # it verbatim as UTF-8 text when pandoc is absent. Visiting the rexxlet
    # directly (/bin/markdown.rxl) shows its own source. The Action target
    # must name the rexxlet explicitly: Apache does not apply DirectoryIndex.
    Action markdown /bin/markdown.rxl
    AddHandler markdown .md
    # The AddType/AddCharset below is the static fallback: if the renderer is
    # ever removed, Apache still serves .md inline as UTF-8 plain text rather
    # than offering it as a download (the default for text/markdown). The
    # charset is pinned to UTF-8 -- the shipped .md files are UTF-8 -- so the
    # browser need not guess. Other encodings are not supported for now; if
    # the need arises, this is where it would be handled.
    AddType text/plain .md
    AddCharset utf-8 .md
    # Route program source through the viewer at /bin/src-viewer.rxl: it
    # highlights the file on the fly when the Rexx Parser is present, or serves
    # it verbatim as UTF-8 text when it is absent. Visiting the rexxlet
    # directly (/bin/src-viewer.rxl) shows its own source. As with markdown,
    # the Action target must name the rexxlet explicitly. Note .rxl is
    # deliberately NOT listed:
    # a rexxlet is run by RexxHTTP (see below), never shown as source.
    Action src-viewer /bin/src-viewer.rxl
    AddHandler src-viewer .rex .rexx .cls .orx .oryx
    # Static fallback, as for .md: if the viewer is ever removed, Apache still
    # serves these inline as UTF-8 plain text rather than offering a download.
    AddType text/plain .rex .rexx .cls .orx .oryx
    AddCharset utf-8 .rex .rexx .cls .orx .oryx
    # Any *.rxl file is a rexxlet: hand it to the RexxHTTP processor.
    AddHandler RexxHTTP .rxl
    # Install-time SetEnv lines are spliced in on the line below (the installer
    # replaces the marker with the output of RexxHTTPSetEnvLines, which
    # documents which variables are emitted). They live inside <Directory> so
    # their scope is our document tree, not the whole server (matters on the
    # keep-apache path). With nothing to set, the line vanishes.
%SETENV%
</Directory>
::END

::Requires "InstallHelpers.cls"