/******************************************************************************/
/*                                                                            */
/* Windows.install - Installer for RexxHTTP on Windows                        */
/* ===================================================                        */
/*                                                                            */
/* This file is part of the RexxHTTP package                                  */
/* [See https://rexx.epbcn.com/rexxhttp/]                                     */
/*                                                                            */
/* Copyright (c) 2006-2026 Josep Maria Blasco <josep.maria.blasco@epbcn.com>  */
/*                                                                            */
/* License: Apache License 2.0 (https://www.apache.org/licenses/LICENSE-2.0)  */
/*                                                                            */
/* Installs RexxHTTP on a CLEAN Windows machine, following the recipe of the  */
/* manual's Installation chapter. Because the Apache project ships no Windows */
/* binary, this fetches a ready-built Apache from Apache Lounge over HTTP,    */
/* unpacks it, enables the cgi and actions modules and the RexxHTTP handler   */
/* through an Include fragment (the main httpd.conf is left untouched bar one */
/* appended Include line), deploys the sources to cgi-bin, plants a minimal   */
/* index rexxlet, installs Apache as a service and smoke-tests with curl.     */
/*                                                                            */
/* On Windows there is NO wrapper: Apache runs RexxHTTP.rex directly through  */
/* its #!rexx shebang, so the handler points straight at the processor.       */
/*                                                                            */
/* This first version targets the CLEAN-MACHINE case. If the chosen server    */
/* root already exists, it STOPS and does nothing, rather than disturb an     */
/* Apache the user set up for something else.                                 */
/*                                                                            */
/* Prerequisites the installer checks but does NOT install:                   */
/*   - ooRexx 5.3.0 or later (out of scope; from the ooRexx project).         */
/*   - The Visual C++ Redistributable (x64, the 14.x "2015-2022" family).     */
/*     Apache Lounge binaries will not start without it; its absence shows up */
/*     as a missing VCRUNTIME140.dll. The installer detects it and, if it is  */
/*     missing, stops with the download link rather than install it silently. */
/*   - curl (shipped with Windows 10/11). Used to fetch Apache and to smoke   */
/*     test. If absent, the installer stops.                                  */
/*                                                                            */
/* Usage:                                                                     */
/*   rexx InstallWindows.rex [--yes] [--zip-url URL] [--root PATH]            */
/*   rexx InstallWindows.rex --uninstall [--yes] [--root PATH]                */
/*                                              [--keep-apache]               */
/*                                                                            */
/*   --yes         Assume "yes" to every prompt (non-interactive).            */
/*   --zip-url U   Override the Apache Lounge ZIP URL (e.g. a newer build).   */
/*   --root P      Server root (default C:\Apache24). For --uninstall, the    */
/*                 same root the install used.                                */
/*   --uninstall   Remove what the installer put here. Symmetric with the     */
/*                 clean-target install: it also deletes the server root,     */
/*                 returning the machine to its pre-install state.            */
/*   --keep-apache With --uninstall, retire ONLY RexxHTTP (the Include line,  */
/*                 the fragment, the cgi-bin sources, the index rexxlet) and  */
/*                 leave the Apache tree in place. The "coexist" path.        */
/*                                                                            */
/* Version history:                                                           */
/*                                                                            */
/* Date     Version Details                                                   */
/* -------- ------- --------------------------------------------------------- */
/* 20260630    1.0  First version.                                            */
/*                                                                            */
/******************************************************************************/

  Parse Source . . myPath

--------------------------------------------------------------------------------
-- Locate the sources (src\ is a sibling of this install\ directory)          --
--------------------------------------------------------------------------------

  -- The package root is the parent of this install\ directory; src\ is its
  -- child. srcRoot feeds the exclusion-model htdocs population (PlantHtdocs).
  srcRoot = .File~new(.Context~package~name)~parentFile~parent
  srcDir  = srcRoot"\src"

  -- The five sources. On Windows the wrapper is NOT used: Apache runs
  -- RexxHTTP.rex directly via its shebang, so the wrapper is not deployed.
  sources = "HTTP.Request.cls HTTP.Response.cls HTTP.OutputStream.cls" -
            "HTTP.Cookie.cls RexxHTTP.rex"

--------------------------------------------------------------------------------
-- Defaults (overridable on the command line)                                 --
--------------------------------------------------------------------------------

  -- Apache Lounge VS17 is a long-established, conservative choice: it runs on
  -- the 14.x VC++ runtime that most machines already carry. Each VS series
  -- page lists exactly one (latest) build; we read it and extract the Win64
  -- ZIP href, so this stays current without hand-editing. The URL can also be
  -- given outright with --zip-url, skipping the page read entirely.
  loungePage = "https://www.apachelounge.com/download/VS17/"
  zipUrl     = ""                 -- empty => discover from loungePage
  serverRoot = "C:\Apache24"

--------------------------------------------------------------------------------
-- Options come pre-parsed and sanitized from the driver (install/uninstall)  --
-- as a Directory; this script does no argument parsing of its own. A quoted   --
-- --root with spaces survived parsing intact, because the driver read it from --
-- .sysCargs (already tokenized) -- it is never re-split here.                  --
--------------------------------------------------------------------------------

  Use Strict Arg opts
  assumeYes  = opts~assumeYes
  uninstall  = (opts~mode == "uninstall")
  keepApache = opts~keepApache
  userMode   = opts~user

  -- A --user install roots under the user's home (no elevation, no service),
  -- for people who cannot write to C:\ or register services -- students on
  -- lab machines, say. Absent an explicit --root, the default moves from
  -- C:\Apache24 to %USERPROFILE%\Apache24 (same folder name, in the home).
  -- USERPROFILE, not HOMEPATH: it is the absolute local profile path, whereas
  -- HOMEPATH omits the drive and may point at a network share on managed PCs.
  If userMode Then Do
    home = Value("USERPROFILE", , "ENVIRONMENT")
    If home \== "" Then serverRoot = home"\Apache24"
  End

  -- Override the defaults only when the user actually supplied a value
  -- (the driver leaves these empty otherwise, preserving "discover/default").
  If opts~serverRoot \== "" Then serverRoot = opts~serverRoot
  If opts~zipUrl     \== "" Then zipUrl     = opts~zipUrl

  -- The Apache Listen port. Windows/Apache Lounge ships httpd.conf with
  -- "Listen 80", so 80 is the default; --port overrides it (e.g. when 80 is
  -- already taken by IIS or another server). The uninstall needs it too, but
  -- reads it from the manifest -- see Uninstall.
  If opts~port \== "" Then port = opts~port
                      Else port = 80

  -- Derived paths, all under the server root we control.
  apacheBin  = serverRoot"\bin\httpd.exe"
  cgiBinDir  = serverRoot"\cgi-bin"
  docRoot    = serverRoot"\htdocs"
  confFile   = serverRoot"\conf\httpd.conf"
  extraConf  = serverRoot"\conf\extra\rexxhttp.conf"
  indexFile  = docRoot"\index.rxl"

  If uninstall Then
    Return Uninstall(assumeYes, keepApache, userMode, serverRoot, apacheBin, -
                     cgiBinDir, confFile, extraConf, indexFile, sources)

  Say
  Say "RexxHTTP Installer for Windows"
  Say "==============================="
  Say
  Say "Sources directory:" srcDir
  Say "Server root:       " serverRoot
  Say

--------------------------------------------------------------------------------
-- Step 1: Require curl                                                        --
--------------------------------------------------------------------------------

  Say "Checking for curl..."
  curlRC = SysCmd("curl --version >nul 2>&1")
  If curlRC \== 0 Then Do
    Say "  ERROR: curl not found. It ships with Windows 10 and 11; this"
    Say "  installer needs it to fetch Apache and to smoke-test. Install or"
    Say "  enable curl and try again."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 2: Check ooRexx (installing it is out of scope)                        --
--------------------------------------------------------------------------------

  Say "Checking ooRexx..."
  If SysCmd("rexx -v >nul 2>&1") \== 0 Then Do
    Say "  ERROR: ooRexx is not installed or not in PATH."
    Say "  RexxHTTP needs ooRexx 5.3.0 or later, from the Open Object Rexx"
    Say "  project: https://sourceforge.net/projects/oorexx/"
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 3: Check the Visual C++ Redistributable (x64, 14.x family)            --
--------------------------------------------------------------------------------

  Say "Checking the Visual C++ Redistributable (x64)..."
  If \HasVCRedist() Then Do
    Say "  ERROR: the x64 Visual C++ Redistributable does not appear to be"
    Say "  installed. Apache Lounge binaries will not start without it (the"
    Say "  symptom is a missing VCRUNTIME140.dll). Install it first, then"
    Say "  re-run this installer. The current redistributable is at:"
    Say "    https://aka.ms/vs/17/release/vc_redist.x64.exe"
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 3b: Refuse to run on a machine that already serves the web             --
--------------------------------------------------------------------------------
-- Three independent probes: a live httpd.exe process, an Apache registered as --
-- a Windows service (even if stopped), and the target TCP port. Between them   --
-- they catch an existing web server whatever its service is called and         --
-- wherever its files live -- the curious user who once installed XAMPP and     --
-- forgot, an Apache under Program Files, IIS, anything. We never adopt or fight --
-- another server; we stop and let the user sort it out. The probes report      --
-- through their text (tasklist, reg and netstat return 0 regardless), so we    --
-- scan the output.                                                             --
--                                                                              --
-- In --user mode only the port probe applies: a user-level install registers   --
-- no service and is meant to coexist on a machine the user does not control,   --
-- so an existing Apache (process or service) on some OTHER port is fine -- it   --
-- would only matter if it holds OUR port, which the port probe already covers. --

  Say "Checking that no other web server is present..."

  If \userMode Then Do
    -- Probe 1: any httpd.exe process alive (Apache under any name or path).
    If CmdOutputHas('tasklist /FI "IMAGENAME eq httpd.exe" /NH', "httpd.exe") Then Do
      Say
      Say "  STOP: an Apache process (httpd.exe) is already running."
      Say "  This installer sets up its own Apache and will not disturb one that"
      Say "  is already there -- XAMPP, WampServer, a manual install, whatever it"
      Say "  may be. Stop that Apache (or use the machine it is not on) and re-run."
      Say "  Nothing was changed."
      Return 1
    End

    -- Probe 1b: any Apache registered as a Windows SERVICE, even if it is not
    -- running right now. Probe 1 only sees a live process; a stopped Apache
    -- service would pass it, and then our own "httpd -k install" would collide
    -- with (or overwrite) the existing service. Every service records its binary
    -- in the registry under HKLM\...\Services\<name>\ImagePath, so one "reg query
    -- ... /s /v ImagePath" lists them all at once (running or stopped) and we
    -- look for an httpd.exe among them. Changing the port would NOT help here --
    -- the clash is over the service, not the port -- so we send the user to a
    -- manual setup rather than suggesting --port.
    If CmdOutputHas("reg query ""HKLM\SYSTEM\CurrentControlSet\Services"" /s /v ImagePath", "httpd.exe") Then Do
      Say
      Say "  STOP: an Apache is already registered as a Windows service."
      Say "  This installer registers its own Apache service, which would clash"
      Say "  with the one already there. --port will not help: the conflict is the"
      Say "  service, not the port. Remove that Apache service (or use a machine"
      Say "  without one) and re-run, or set RexxHTTP up by hand."
      Say "  Nothing was changed."
      Return 1
    End
  End

  -- Probe 2: is the TCP port we are about to use already taken (by IIS or
  -- anything else)? The local address is the second token; its port is whatever
  -- follows the last colon, which also does the right thing for IPv6 forms like
  -- [::]:80. We match only an exact port in LISTENING state, so a different port
  -- and ephemeral :NNNport do not fool us. The port is 80 by default or whatever
  -- --port set; if it is busy we stop and point at the --port way out.
  net = .Array~new
  Address System "netstat -ano -p tcp" With Output Using (net) Error Using (.Array~new)
  Do line Over net
    If \line~caselessContains("LISTENING") Then Iterate
    Parse Var line . localAddr .
    colon = localAddr~lastPos(":")
    If colon == 0 Then Iterate
    If localAddr~substr(colon + 1) == port Then Do
      Say
      Say "  STOP:" PortBusyMsg(port)
      Say "  Nothing was changed."
      Return 1
    End
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 4: Stop if the server root already exists (clean-machine policy)       --
--------------------------------------------------------------------------------

  Say "Checking that" serverRoot "does not already exist..."
  If SysFileExists(serverRoot) Then Do
    Say
    Say "  STOP:" serverRoot "already exists."
    Say "  This first version of the installer only operates on a clean target:"
    Say "  it will not touch an Apache that is already there. Choose another"
    Say "  location with --root, or remove the existing one, and try again."
    Say "  Nothing was changed."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 5: Resolve the Apache Lounge ZIP URL                                   --
--------------------------------------------------------------------------------

  If zipUrl == "" Then Do
    Say "Finding the latest Apache (Win64) on" loungePage"..."
    zipUrl = DiscoverZipUrl(loungePage)
    If zipUrl == "" Then Do
      Say "  ERROR: could not find a Win64 build link on the download page."
      Say "  The page layout may have changed. Pass the ZIP URL directly with"
      Say "  --zip-url, copying it from" loungePage
      Return 1
    End
    Say "  Found:" zipUrl
  End
  Else
    Say "Using the ZIP URL given on the command line:" zipUrl

--------------------------------------------------------------------------------
-- Step 6: Confirm before making changes                                      --
--------------------------------------------------------------------------------

  Say
  Say "About to:"
  Say "  - download and unpack Apache into" serverRoot
  Say "  - enable cgi + actions and the RexxHTTP handler via an Include"
  Say "  - deploy the RexxHTTP sources to" cgiBinDir
  Say "  - plant a smoke-test rexxlet at" indexFile
  If userMode Then
    Say "  - start Apache in its own window (no service), and smoke-test it"
  Else
    Say "  - install Apache as a service, start it and smoke-test it"
  Say
  If \assumeYes Then
    If \Ask("Proceed?") Then Do
      Say "Aborted. Nothing was changed."
      Return 1
    End

--------------------------------------------------------------------------------
-- Step 7: Download Apache                                                     --
--------------------------------------------------------------------------------

  Say
  Say "Downloading Apache..."
  zipTmp = .File~temporaryPath || "rexxhttp-apache.zip"
  -- -L follows redirects; a browser-like UA avoids the odd 403.
  cmd = 'curl -sL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"' -
        '-o "'zipTmp'" "'zipUrl'"'
  If SysCmd(cmd) \== 0 Then Do
    Say "  ERROR: download failed."
    Return 1
  End
  If \SysFileExists(zipTmp) Then Do
    Say "  ERROR: nothing was downloaded."
    Return 1
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 8: Unpack Apache with tar.exe (native on Windows 10/11)               --
--------------------------------------------------------------------------------

  Say "Unpacking Apache..."
  -- The ZIP contains a top-level Apache24\ folder. Unpack into a temp staging
  -- dir, then move Apache24's contents to the chosen server root, so the
  -- result is serverRoot\bin (not serverRoot\Apache24\bin).
  stageDir = .File~temporaryPath || "rexxhttp-stage"
  Call SysFileTree stageDir, "found.", "DO"      -- probe; ignore result
  "cmd /c rmdir /s /q """stageDir""" 2>nul"
  "cmd /c mkdir """stageDir""""
  If SysCmd('tar -xf "'zipTmp'" -C "'stageDir'"') \== 0 Then Do
    Say "  ERROR: failed to unpack the archive (is tar.exe present?)."
    Return 1
  End

  -- Verify the expected layout before trusting it: Apache24\bin\httpd.exe.
  If \SysFileExists(stageDir"\Apache24\bin\httpd.exe") Then Do
    Say "  ERROR: the download did not contain Apache24\bin\httpd.exe."
    Say "  What downloaded may not be a valid Apache Lounge ZIP."
    Return 1
  End

  "cmd /c move """stageDir"\Apache24"" """serverRoot""" >nul"
  If \SysFileExists(apacheBin) Then Do
    Say "  ERROR: could not place Apache at" serverRoot"."
    Return 1
  End
  "cmd /c rmdir /s /q """stageDir""" 2>nul"
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 9: Point ServerRoot at our chosen location                            --
--------------------------------------------------------------------------------

  -- Apache Lounge ships ServerRoot baked to its own build path (it varies by
  -- build). Rewrite it to the location we actually installed into, so every
  -- derived path (htdocs, cgi-bin, logs) resolves correctly. When --port asked
  -- for a non-default port, the same pass rewrites httpd.conf's "Listen 80".
  Say "Setting ServerRoot in httpd.conf..."
  Call RewriteServerRoot confFile, serverRoot, port
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 10: Write the RexxHTTP Include fragment and reference it              --
--------------------------------------------------------------------------------

  Say "Writing config fragment" extraConf"..."
  frag = .Resources~RexxHTTPConf~makeString("L", "0D0A"x)
  -- The <Directory> in the fragment must name the REAL document root, not the
  -- hard-wired C:/Apache24/htdocs -- otherwise a --root or --user install (which
  -- roots elsewhere, e.g. under %USERPROFILE%) would point the handler at a
  -- directory that does not hold the served files, and RexxHTTP would never run.
  -- Apache config wants forward slashes, so we convert the backslashes.
  fwdRoot = docRoot~changeStr("\", "/")
  frag = frag~changeStr("%docRoot%", fwdRoot)
  -- Splice in the install-time SetEnv lines (RexxHTTPSetEnvLines documents
  -- which variables are emitted). We pass the forward-slashed root: Apache reads
  -- it, and loadPackage accepts "/" on Windows too. .endOfLine is CRLF here, so
  -- strip the trailing one the routine adds, matching the fragment's CRLF.
  frag = frag~changeStr("%SETENV%", RexxHTTPSetEnvLines(fwdRoot, "    ")~strip("T", .endOfLine))
  -- The fragment ships "ServerName localhost"; when we are on a non-default
  -- port, name the server with it (ServerName localhost:NNNN) so redirects and
  -- self-references use the right port.
  If port \== 80 Then
    frag = frag~changeStr("ServerName localhost", "ServerName localhost:"port)
  Call CharOut extraConf, frag
  Call Stream extraConf, "C", "Close"

  -- Append a single Include line to httpd.conf (additive, reversible).
  Say "Adding Include to httpd.conf..."
  Call LineOut confFile, ""
  Call LineOut confFile, "# RexxHTTP: enable the cgi/actions modules and the handler."
  Call LineOut confFile, "Include conf/extra/rexxhttp.conf"
  Call Stream confFile, "C", "Close"
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 11: Deploy the sources to cgi-bin                                     --
--------------------------------------------------------------------------------

  Say "Deploying sources to" cgiBinDir"..."
  Do src Over sources~makeArray(" ")
    Call SysFileCopy srcDir'\'src, cgiBinDir'\'src
    If result \== 0 Then Do
      Say "  ERROR: failed to copy" src", error code=" result
      Return 1
    End
  End
  Say "  OK."

--------------------------------------------------------------------------------
-- Step 12: Populate the document root (exclusion model)                      --
--------------------------------------------------------------------------------
-- Instead of enumerating what to deploy, copy the WHOLE package into htdocs
-- and leave out only the scaffolding (see HtdocsExclude): install\, tests\,
-- pack.rex, and the two repo-only metadata files. Everything else becomes the
-- browsable sample web: the root index rexxlet, apps\page.cls, the stylesheets,
-- the examples\ tree with their pre-rendered .highlighted sources, src\ as a
-- readable copy, the manual PDF, readme.md and LICENSE. The AddHandler in the
-- conf fragment runs only *.rxl files as rexxlets, so
-- every .cls/.rex/.md copied here is served as text, never executed. src\
-- additionally lives in cgi-bin (Step 11), where it executes: two destinations.
--
-- The installer owns the server root, so PlantHtdocs copies in-process (no
-- privileged prefix). It returns the manifest of planted files (paths relative
-- to docRoot, forward-slashed), recorded in the management directory below so
-- the uninstall retires exactly what was planted and nothing of the operator's.

  Say "Populating" docRoot "from the package (exclusion model)..."
  planted = PlantHtdocs(srcRoot, docRoot, "")
  Say "  OK." planted~items "files planted."

--------------------------------------------------------------------------------
-- Step 13: Start httpd                                                       --
--------------------------------------------------------------------------------

  If userMode Then Do
    -- User-level install: no service (that needs elevation). Plant a launcher
    -- in the server root so the user can start Apache without remembering the
    -- httpd.exe syntax, then start it now so the install ends up serving.
    startCmd = serverRoot"\start.cmd"
    Say "Writing the launcher" startCmd"..."
    cmd = .Stream~new(startCmd)
    cmd~open("write replace")
    -- The launcher starts httpd DETACHED in its own window and returns at once,
    -- so it does not tie up the console it was run from. Closing the Apache
    -- window (titled "Apache 2.4") stops the server. start's first quoted token
    -- is the window TITLE, so we pass one explicitly before the executable --
    -- otherwise start would treat the quoted exe path as the title and fail.
    cmd~lineout("@echo off")
    cmd~lineout("rem Start RexxHTTP's Apache (user-level install, no service).")
    cmd~lineout("rem A new window titled 'Apache 2.4' opens; close it to stop the server.")
    cmd~lineout('start "Apache 2.4" "'apacheBin'"')
    cmd~close
    Say "  OK."

    Say "Starting Apache (no service; user-level install)..."
    -- Launch it detached in its own window, so it keeps running after this
    -- installer returns and does not block the install console.
    Address System "cmd /c start ""RexxHTTP Apache"" """ || apacheBin || """"
    Call SysSleep 1.5
    Say "  OK."
  End
  Else Do
    Say "Installing Apache as a Windows service..."
    -- Run as a service (not a detached console window): it starts automatically
    -- with Windows and needs no visible window kept open. This requires the
    -- elevation the driver already checked for. -k install registers the
    -- service; -k start launches it.
    Address System "cmd /c """ || apacheBin || """ -k install >nul 2>&1"
    If RC \== 0 Then Do
      Say "  ERROR: could not register the Apache service (httpd -k install)."
      Say "  Make sure this console is elevated (Run as administrator)."
      Return 1
    End
    Address System "cmd /c """ || apacheBin || """ -k start >nul 2>&1"
    If RC \== 0 Then Do
      Say "  ERROR: the Apache service was registered but did not start"
      Say "  (httpd -k start). Check" serverRoot"\logs\error.log."
      Return 1
    End
    Call SysSleep 1.5
    Say "  OK."
  End

--------------------------------------------------------------------------------
-- Step 13b: Deploy the management directory (self-sufficient uninstall)       --
--------------------------------------------------------------------------------
-- Copy the five install\ files to a stable location under %ProgramData% and
-- write a manifest recording the server root. This is the platform where the
-- manifest earns its keep: the management directory now lives OUTSIDE the
-- Apache tree, so the script's parent is no longer the server root and the
-- old deduce-by-path trick is gone -- the manifest's SERVERROOT is the only
-- truth. It also absorbs a --root'd non-standard root, which a later uninstall
-- would otherwise have to be handed again. Alongside the files we GENERATE a
-- launcher, rexxhttp-uninstall.cmd, whose whole reason to exist is one line:
-- it steps the CMD session to a neutral cwd (cd /d C:\) BEFORE invoking the
-- uninstaller, so the uninstall can then delete the entire Apache tree and its
-- own management directory with nothing holding a live cwd inside either. It
-- is generated, not copied, because its body embeds this machine's resolved
-- mgmtDir path. Done before the smoke test so a failed test still leaves a
-- working uninstaller. SysMkDir/SysFileCopy, not sudo: we already run elevated.

  If userMode Then Do
    -- A --user install writes nothing outside the home, so the management
    -- directory (which lives under %ProgramData% and needs elevation to
    -- create) is not deployed here. That directory exists only to give a
    -- service-style install a self-sufficient, service-aware uninstaller; a
    -- --user install needs neither -- it registers no service and keeps
    -- everything under %USERPROFILE%\Apache24. It is removed by running
    -- "rexx uninstall --user" from the unpacked package (the driver skips the
    -- service teardown and the elevation check, and deletes the home folder).
    Say "User-level install: no separate uninstaller is deployed."
    Say "  (To remove it later, run 'rexx uninstall --user' from the unpacked"
    Say "  package. Closing the Apache window stops the server meanwhile.)"
  End
  Else Do
    mgmtDir = ManagementDir("Windows", serverRoot)
    Say "Installing the uninstaller to" mgmtDir"..."
    installDir = .File~new(.Context~package~name)~parentFile~absolutePath
    Call SysMkDir mgmtDir
    deployOK = 1
    Do f Over ManagementFiles()~makeArray(" ")
      Call SysFileCopy installDir"\"f, mgmtDir"\"f
      If result \== 0 Then Do
        Say "  WARNING: could not copy" f "to" mgmtDir"."
        Say "  The install itself is fine, but the uninstaller will not be"
        Say "  available from a stable location. You can still uninstall from"
        Say "  this download directory, passing the same --root you used here."
        deployOK = 0
        Leave
      End
    End
    If deployOK Then Do
      -- Record the port in the manifest only when we changed it: on a default
      -- (80) install there is nothing for the uninstall to restore, so we pass ""
      -- and no PORT key is written.
      If port == 80 Then manifestPort = ""
                    Else manifestPort = port
      Call WriteManifest ManifestPath("Windows", mgmtDir), serverRoot, manifestPort
      -- The htdocs manifest: the files planted in htdocs under the exclusion
      -- model, so the uninstall retires exactly those and leaves operator files
      -- untouched. It lives beside the main manifest in the management directory,
      -- outside the Apache tree, so it survives even a symmetric uninstall that
      -- deletes the whole server root.
      Call WriteHtdocsManifest HtdocsManifestPath("Windows", mgmtDir), planted
      -- Generate the launcher. The neutral cwd (cd /d C:\) is the whole point:
      -- it is what frees the uninstall to remove the Apache tree without anything
      -- holding a live cwd. %* forwards flags such as --keep-apache through to the
      -- uninstaller. The uninstall empties this directory of everything EXCEPT
      -- this .cmd (it cannot delete the file CMD is still reading without CMD then
      -- printing "The system cannot find the path specified."). So the .cmd's last
      -- act spawns a DETACHED child (start /b) that waits ~1s for CMD to release
      -- the file, then deletes this .cmd and rmdir's the now-empty directory. The
      -- parent .cmd returns normally with the file still present, so there is no
      -- failed re-read and no error message; the child does the final cleanup
      -- after everyone has let go. %~f0 is this .cmd's own path; the directory is
      -- passed as an absolute path with NO trailing backslash, because rmdir on
      -- some CMD versions balks at a path ending in "\" (which %~dp0 would give).
      cmdPath = mgmtDir"\rexxhttp-uninstall.cmd"
      cmd = .Stream~new(cmdPath)
      cmd~open("write replace")
      cmd~lineout("@echo off")
      cmd~lineout("cd /d C:\")
      cmd~lineout("rexx """mgmtDir"\uninstall.rex"" %*")
      cmd~lineout("start """" /b cmd /c ""timeout /t 1 /nobreak >nul & del ""%~f0"" >nul 2>&1 & rmdir """mgmtDir""" >nul 2>&1""")
      cmd~close
    End
    Say "  OK."
  End


--------------------------------------------------------------------------------
-- Step 14: Smoke test                                                        --
--------------------------------------------------------------------------------

  -- The base URL for the smoke test and the messages. Port 80 is implicit
  -- (http://localhost/); any other port is spelled out (http://localhost:NNNN/).
  If port == 80 Then baseUrl = "http://localhost"
                Else baseUrl = "http://localhost:"port

  Say "Smoke test (curl" baseUrl"/)..."
  out = .Array~new
  Address System "curl -s --noproxy localhost" baseUrl"/" -
    With Output Using (out) Error Using (.Array~new)
  body = ""
  Do l Over out
    body = body || l
  End

  Say
  If body~caselessContains("RexxHTTP") Then Do
    Say "============================================================"
    Say " SUCCESS: a minimal RexxHTTP installation is up and running."
    Say "============================================================"
    Say
    Say " Open it in a browser at:  " || baseUrl"/"
    Say " or from the command line:  curl" baseUrl"/"
    Say
    Say " The welcome page links to a set of example rexxlets you can"
    Say " explore. They are small Rexx programs; follow a link to see"
    Say " each one run."
    Say
    If userMode Then Do
      Say " Apache is running WITHOUT a Windows service (user-level install),"
      Say " so it does NOT start automatically when Windows starts. To start it"
      Say " again after a reboot, run:"
      Say
      Say "   """startCmd""""
      Say
      Say " It opens Apache in a separate window titled 'Apache 2.4' and returns"
      Say " to your prompt. Closing that Apache window stops the server."
      Say
      Say " To uninstall later, run from the install subdirectory of the"
      Say " unpacked package (no elevation needed):"
      Say
      Say "   rexx uninstall --user"
      Say
    End
    Else Do
      Say " Apache runs as a Windows service, so it starts automatically"
      Say " with Windows and needs no window kept open."
      Say
      Say " To uninstall later, open an elevated console and run:"
      Say
      Say "   """ || ManagementDir("Windows", serverRoot) || "\rexxhttp-uninstall.cmd"""
      Say
      Say " (add --keep-apache to remove only RexxHTTP and leave Apache.)"
      Say
    End
    Say " You can find a copy of the RexxHTTP documentation at:"
    Say "   https://rexx.epbcn.com/rexxhttp/"
    Say " and at:"
    Say "   " || baseUrl"/"
    Say
    Return 0
  End
  Else Do
    Say "============================================================"
    Say " WARNING: install finished, but the smoke test did not return"
    Say " the expected output. " || baseUrl"/ returned:"
    Say "   " || body~strip~left(200)
    Say " Check" serverRoot"\logs\error.log and the config fragment."
    Say "============================================================"
    Return 1
  End

/******************************************************************************/
/* Uninstall: remove what the installer put here. By default this is          */
/* symmetric with the clean-target install -- it deletes the whole server     */
/* root, which the install created, returning the machine to its pre-install   */
/* state. With keepApache it retires ONLY RexxHTTP: the Include line we added  */
/* to httpd.conf, the fragment, the cgi-bin sources and the index rexxlet,     */
/* leaving the Apache tree otherwise intact (the "coexist" path).             */
/******************************************************************************/
Uninstall: Procedure
  Use Strict Arg assumeYes, keepApache, userMode, serverRoot, apacheBin, -
                 cgiBinDir, confFile, extraConf, indexFile, sources

  Say
  Say "RexxHTTP Uninstaller for Windows"
  Say "================================="
  Say
  -- docRoot is derived from serverRoot like every other path; the coexist
  -- path below needs it. (It was previously referenced there without being
  -- defined in this Procedure -- a latent bug on the --keep-apache path,
  -- fixed here by deriving it up front.)
  docRoot = serverRoot"\htdocs"

  -- Recover the real server root. The management directory now lives under
  -- %ProgramData%, OUTSIDE the Apache tree, so the script's parent is NO
  -- longer the server root and the old deduce-by-path trick cannot apply --
  -- the MANIFEST is the single source of truth. When this uninstaller runs
  -- from the management directory the install left behind, we read SERVERROOT
  -- from the manifest beside the script; that value absorbs whatever --root
  -- was used at install time, so uninstall works with no flags and no
  -- surviving download. The passed-in serverRoot (default or --root) is the
  -- fallback only when we are NOT running from a management directory
  -- (e.g. invoked from a loose download, where the manifest is absent).
  scriptDir = .File~new(.Context~package~name)~parentFile
  manifestPort = ""
  If scriptDir~name~caselessEquals("rexxhttp") Then Do
    manRoot = ReadManifestRoot(ManifestPath("Windows", scriptDir~absolutePath))
    If manRoot \== "" Then serverRoot = manRoot
    -- The port the install recorded, if it changed it from 80. Empty means the
    -- install used the default, so there is no Listen to restore.
    manifestPort = ReadManifestPort(ManifestPath("Windows", scriptDir~absolutePath))
    apacheBin = serverRoot"\bin\httpd.exe"
    cgiBinDir = serverRoot"\cgi-bin"
    confFile  = serverRoot"\conf\httpd.conf"
    extraConf = serverRoot"\conf\extra\rexxhttp.conf"
    docRoot   = serverRoot"\htdocs"
    indexFile = docRoot"\index.rxl"
  End

  Say "Server root:" serverRoot
  Say

  If \SysFileExists(serverRoot) Then Do
    Say serverRoot "does not exist. Nothing to uninstall."
    Say "(If you installed into a different root, pass it with --root.)"
    Return 0
  End

  Say "About to remove:"
  If keepApache Then Do
    Say "  - the RexxHTTP Include line from" confFile
    Say "  - the config fragment" extraConf
    Say "  - the RexxHTTP sources from" cgiBinDir
    Say "  - the files RexxHTTP planted in" docRoot "(per the install manifest)"
    Say "  - (Apache is kept: --keep-apache)"
  End
  Else
    Say "  - the entire server root" serverRoot "(Apache and all)"
  Say
  If \assumeYes Then
    If \Ask("Proceed?") Then Do
      Say "Aborted. Nothing was changed."
      Return 1
    End

  If \keepApache Then Do
    -- Symmetric uninstall: the install created the whole tree, so remove it.
    -- Stop Apache before deleting the binaries it is running from. How Apache
    -- was started differs by mode, so the teardown does too.
    Say
    If userMode Then Do
      -- A --user install registered no service: Apache runs as a detached
      -- httpd from the start.cmd window. There is nothing to -k stop or
      -- -k uninstall (those would just fail silently), so we go straight to
      -- taskkill, which is what actually ends that detached httpd.
      Say "Stopping Apache (user-level install; no service)..."
      Address System "cmd /c taskkill /f /im httpd.exe >nul 2>&1"
      Call SysSleep 0.5
      Say "  OK."
    End
    Else Do
      -- Normal install: DE-REGISTER the Apache service before deleting the
      -- binaries it points at, so a registered service must not survive.
      -- Order matters: stop, then uninstall the service. Failures are ignored
      -- (the service may be absent, e.g. a partial install). The taskkill is a
      -- safety net for a stray detached httpd from an older console-style run.
      Say "Stopping and removing the Apache service..."
      Address System "cmd /c """ || apacheBin || """ -k stop >nul 2>&1"
      Call SysSleep 1
      Address System "cmd /c """ || apacheBin || """ -k uninstall >nul 2>&1"
      Call SysSleep 0.5
      Address System "cmd /c taskkill /f /im httpd.exe >nul 2>&1"
      Call SysSleep 0.5
      Say "  OK."
    End
    -- The management directory this uninstaller runs from lives under
    -- %ProgramData%, OUTSIDE this tree, and the launcher put the CMD session
    -- at a neutral cwd (C:\) before we ran -- so nothing here is a live
    -- process's cwd and the whole server root comes away clean in one rmdir.
    Say "Removing the server root" serverRoot"..."
    Address System "cmd /c rmdir /s /q """ || serverRoot || """ 2>nul"
    Say "  OK."
    -- Empty the management directory too (it lives outside the tree just
    -- removed, so the rmdir above did not take it). This clears its files;
    -- the launcher .cmd deletes itself and the directory afterwards, from a
    -- detached child, so CMD never loses the file it is still reading.
    Call RemoveMgmtDir serverRoot
    Say
    Say "============================================================"
    Say " RexxHTTP and Apache removed. The server root is gone and the"
    Say " machine is back to its pre-install state."
    Say "============================================================"
    Return 0
  End

  -- Coexist path: surgical retirement, leaving the Apache SERVICE in place.
  -- We do NOT stop or de-register the service here (that would break the
  -- --keep-apache promise: Apache must stay a Windows service, starting with
  -- the machine). We edit its config and reload it in place, the same way
  -- the Linux installer does systemctl reload. See the -k restart below.

  -- 1. Strip the Include line (and the comment we wrote above it) from
  --    httpd.conf, rewriting the file without those two lines and nothing else.
  Say "Removing the RexxHTTP Include from" confFile"..."
  Call StripInclude confFile
  Say "  OK."

  -- 1b. If the install changed Apache's Listen port, put it back to 80. This
  -- keeps the --keep-apache promise whole: the operator's Apache is left as it
  -- was before RexxHTTP, port included. Only the manifest knows we changed it.
  If manifestPort \== "", manifestPort \== 80 Then Do
    Say "Restoring Apache's Listen port to 80..."
    Call RewriteListenPort confFile, manifestPort, 80
    Say "  OK."
  End

  -- 2. Delete the fragment.
  Say "Removing the config fragment" extraConf"..."
  Address System "cmd /c del /q """ || extraConf || """ >nul 2>&1"
  Say "  OK."

  -- 3. Delete the deployed sources from cgi-bin.
  Say "Removing sources from" cgiBinDir"..."
  Do src Over sources~makeArray(" ")
    Address System "cmd /c del /q """ || cgiBinDir"\"src || """ >nul 2>&1"
  End
  Say "  OK."

  -- 4. Remove everything the installer planted in htdocs, and nothing else.
  -- Read the htdocs manifest written at install time and retire exactly those
  -- files, pruning the directories they leave empty. Operator files (and the
  -- directories that still hold them) are left untouched -- the coexist-safe
  -- behaviour that matters on this --keep-apache path. If the manifest is
  -- missing (an install predating the exclusion model), there is nothing to
  -- walk and the step is a no-op. We run elevated and own htdocs, so no sudo.
  mgmtDir = ManagementDir("Windows", serverRoot)
  planted = ReadHtdocsManifest(HtdocsManifestPath("Windows", mgmtDir))
  Say "Removing" planted~items "planted files from" docRoot"..."
  Call UnplantHtdocs docRoot, planted, ""
  Say "  OK."

  -- Reload the config into the still-registered service. -k restart tells the
  -- running Apache service to re-read httpd.conf (now without our Include), so
  -- it comes back serving without the RexxHTTP handler -- and crucially it
  -- stays a Windows service. No console-detached httpd, no popup window.
  Say "Reloading Apache without the RexxHTTP config..."
  Address System "cmd /c """ || apacheBin || """ -k restart >nul 2>&1"
  Call SysSleep 1
  Say "  OK."

  Say
  Say "============================================================"
  Say " RexxHTTP removed. The Apache tree at" serverRoot
  Say " is left in place and running."
  Say "============================================================"

  -- Apache stays, so nothing above emptied the management directory; do it
  -- here, the same way the symmetric path does (the launcher .cmd removes
  -- itself and the directory afterwards, from a detached child).
  Call RemoveMgmtDir serverRoot
  Return 0

/******************************************************************************/
/* RemoveMgmtDir: empty the %ProgramData% management directory of everything   */
/* EXCEPT the running launcher .cmd -- the five copied files and the manifest. */
/* These can be deleted in place while we run (ooRexx has already tokenised    */
/* them into memory). We deliberately do NOT delete rexxhttp-uninstall.cmd,    */
/* nor rmdir the directory: that .cmd is still being read by the CMD process   */
/* that launched us, and deleting a file out from under CMD makes it print     */
/* "The system cannot find the path specified." when it returns to disk for    */
/* the next line. Instead the launcher itself, as its last act, spawns a       */
/* detached child that waits for CMD to let go and THEN removes the .cmd and   */
/* the now-empty directory (see the launcher generated in Step 13b). Called    */
/* from BOTH uninstall paths -- symmetric and coexist.                         */
/******************************************************************************/
RemoveMgmtDir: Procedure
  Use Strict Arg serverRoot
  mgmtDir = ManagementDir("Windows", serverRoot)
  Do f Over ManagementFiles()~makeArray(" ")
    Call SysFileDelete mgmtDir"\"f
  End
  Call SysFileDelete ManifestPath("Windows", mgmtDir)
  Return
/* appended -- the "# RexxHTTP: ..." comment and the "Include ...rexxhttp"     */
/* line -- and nothing else. Matching is by content, not by position, so a     */
/* hand-edited conf is handled too. Idempotent: a conf without them is left    */
/* unchanged.                                                                  */
/******************************************************************************/
StripInclude: Procedure
  Use Strict Arg conf
  kept = .Array~new
  Do While Lines(conf) > 0
    line = LineIn(conf)
    low  = Lower(line~strip)
    -- Drop the comment we wrote and the Include of our fragment.
    If low~abbrev("# rexxhttp:") Then Iterate
    If low~abbrev("include"), low~contains("rexxhttp") Then Iterate
    kept~append(line)
  End
  Call Stream conf, "C", "Close"

  Call Stream conf, "C", "Open Write Replace"
  Do line Over kept
    Call LineOut conf, line
  End
  Call Stream conf, "C", "Close"
  Return

/******************************************************************************/
/* RewriteListenPort: change a "Listen <fromPort>" directive back to          */
/* "Listen <toPort>", used by the coexist uninstall to undo the port change   */
/* the install made. Only a Listen line whose port equals fromPort is touched, */
/* so any other Listen the operator may have is left alone. Idempotent: a conf */
/* without a matching Listen is left unchanged. Shares RewriteListen with the  */
/* install so the address:port forms are handled the same way.                */
/******************************************************************************/
RewriteListenPort: Procedure
  Use Strict Arg conf, fromPort, toPort
  lines = .Array~new
  Do While Lines(conf) > 0
    line = LineIn(conf)
    If line~strip~caselessAbbrev("Listen") Then Do
      stripped = line~strip
      Parse Var stripped . spec .
      colon = spec~lastPos(":")
      If colon > 0 Then linePort = spec~substr(colon + 1)
                   Else linePort = spec
      If linePort == fromPort Then line = RewriteListen(line, toPort)
    End
    lines~append(line)
  End
  Call Stream conf, "C", "Close"

  Call Stream conf, "C", "Open Write Replace"
  Do line Over lines
    Call LineOut conf, line
  End
  Call Stream conf, "C", "Close"
  Return

/******************************************************************************/
/* HasVCRedist: is the x64 VC++ 14.x runtime present? Registry first (the    */
/* canonical check installers use), VCRUNTIME140.dll as a fallback.          */
/******************************************************************************/
HasVCRedist:
  key = "HKLM\SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X64"
  If SysCmd('reg query "'key'" /v Installed >nul 2>&1') == 0 Then Return 1
  -- Fallback: the runtime DLL itself in System32.
  win = Value("SystemRoot", , "ENVIRONMENT")
  If win == "" Then win = "C:\Windows"
  Return SysFileExists(win"\System32\VCRUNTIME140.dll")

/******************************************************************************/
/* DiscoverZipUrl: read an Apache Lounge VS series page and return the        */
/* absolute URL of its Win64 httpd ZIP. Each series page lists one build.     */
/* Matching is caseless (the page mixes Win64/win64, VS17/vs17).             */
/******************************************************************************/
DiscoverZipUrl:
  Use Strict Arg pageUrl
  cmd = 'curl -sL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"' -
        '"'pageUrl'"'
  page = .Array~new
  Address System cmd With Output Using (page) Error Using (.Array~new)
  If RC \== 0 Then Return ""

  -- Pull the href that names a Win64 httpd ZIP under /binaries/.
  href = ""
  Do line Over page
    low = Lower(line)
    If low~contains("/binaries/httpd-"),    -
       low~contains("win64"),               -
       low~contains(".zip") Then Do
      -- Extract the href="...zip" token on this line.
      p = low~pos('href="')
      If p > 0 Then Do
        rest = line~substr(p + 6)
        q = rest~pos('"')
        If q > 0 Then Do
          href = rest~left(q - 1)
          Leave
        End
      End
    End
  End

  If href == "" Then Return ""
  -- Make it absolute against the site root if it came back path-relative.
  If href~caselessAbbrev("http") Then Return href
  Return "https://www.apachelounge.com" || href

/******************************************************************************/
/* RewriteServerRoot: Apache Lounge bakes its own build path (e.g.            */
/* C:/Apache24-64) into httpd.conf -- not only in ServerRoot but as absolute  */
/* paths in DocumentRoot, <Directory> and ScriptAlias. Rewrite ServerRoot and */
/* replace every occurrence of the baked build-root with our chosen root, so  */
/* nothing points at a directory that does not exist on this machine.         */
/* Also rewrite the Listen port when the caller asked for a non-default one:   */
/* httpd.conf ships "Listen 80", and we change it in place (rather than adding */
/* a Listen to our fragment) so there is exactly one Listen and no clash. The  */
/* address part of "Listen 0.0.0.0:80" style lines, if any, is preserved.      */
/******************************************************************************/
RewriteServerRoot:
  Use Strict Arg conf, root, port = 80
  fwd = root~changeStr("\", "/")

  -- Derive the factory build-root from DocumentRoot (".../htdocs" -> "...").
  baked = ""
  Do While Lines(conf) > 0
    line = LineIn(conf)
    If line~strip~caselessAbbrev("DocumentRoot") Then Do
      Parse Var line . '"' path '"' .
      lp = path~caselessLastPos("/htdocs")
      If lp > 0 Then baked = path~left(lp - 1)
      Leave
    End
  End
  Call Stream conf, "C", "Close"

  -- Rewrite: ServerRoot line explicitly, the Listen port when non-default,
  -- plus any baked build-root anywhere.
  lines = .array~new
  Do While Lines(conf) > 0
    line = LineIn(conf)
    If line~strip~caselessAbbrev("ServerRoot") Then
      line = 'ServerRoot "'fwd'"'
    Else If port \== 80, line~strip~caselessAbbrev("Listen") Then
      line = RewriteListen(line, port)
    Else If baked \== "", baked \== fwd Then
      line = line~changeStr(baked, fwd)
    lines~append(line)
  End
  Call Stream conf, "C", "Close"

  Call Stream conf, "C", "Open Write Replace"
  Do line Over lines
    Call LineOut conf, line
  End
  Call Stream conf, "C", "Close"
  Return

/******************************************************************************/
/* Resources: the files this installer generates.                            */
/******************************************************************************/

-- The Include fragment. It enables the two modules (they ship commented out
-- in httpd.conf, so we LoadModule them here rather than editing that file),
-- declares the handler pointing straight at RexxHTTP.rex (no wrapper on
-- Windows), and treats every *.rxl file in the document root as a rexxlet,
-- with DirectoryIndex index.rxl. ${SRVROOT} resolves to the rewritten ServerRoot.
::Resource RexxHTTPConf
# RexxHTTP drop-in configuration (Windows / Apache Lounge).
# Included from httpd.conf by install\InstallWindows.rex.

LoadModule cgi_module modules/mod_cgi.so
LoadModule actions_module modules/mod_actions.so

# Give Apache a name so it stops emitting AH00558 ("Could not reliably
# determine the server's fully qualified domain name") at start/stop.
ServerName localhost

# On Windows Apache runs RexxHTTP.rex directly via its #!rexx shebang;
# the handler points straight at the processor (no wrapper).
Action RexxHTTP /cgi-bin/RexxHTTP.rex

<Directory "%docRoot%">
    DirectoryIndex index.rxl readme.md
    # Route every *.md through the Markdown renderer at /md/index.rxl: it turns
    # the file into a styled HTML page (via pandoc when present), or serves
    # it verbatim as UTF-8 text when pandoc is absent. Visiting /md/ directly
    # shows a short help page. The Action target must name the rexxlet
    # explicitly (/md/index.rxl): Apache does not apply DirectoryIndex to it.
    Action markdown /md/index.rxl
    AddHandler markdown .md
    # The AddType/AddCharset below is the static fallback: if the renderer is
    # ever removed, Apache still serves .md inline as UTF-8 plain text rather
    # than offering it as a download (the default for text/markdown). The
    # charset is pinned to UTF-8 -- the shipped .md files are UTF-8 -- so the
    # browser need not guess. Other encodings are not supported for now; if
    # the need arises, this is where it would be handled.
    AddType text/plain .md
    AddCharset utf-8 .md
    # Route program source through the viewer at /src-viewer/index.rxl: it
    # highlights the file on the fly when the Rexx Parser is present, or serves
    # it verbatim as UTF-8 text when it is absent. Visiting /src-viewer/
    # directly shows a short help page. As with markdown, the Action target
    # must name the rexxlet explicitly. Note .rxl is deliberately NOT listed:
    # a rexxlet is run by RexxHTTP (see below), never shown as source.
    Action src-viewer /src-viewer/index.rxl
    AddHandler src-viewer .rex .rexx .cls .orx
    # Static fallback, as for .md: if the viewer is ever removed, Apache still
    # serves these inline as UTF-8 plain text rather than offering a download.
    AddType text/plain .rex .rexx .cls .orx
    AddCharset utf-8 .rex .rexx .cls .orx
    # Any *.rxl file is a rexxlet: hand it to the RexxHTTP processor.
    AddHandler RexxHTTP .rxl
    # Install-time SetEnv lines are spliced in on the line below (the installer
    # replaces the marker with the output of RexxHTTPSetEnvLines, which
    # documents which variables are emitted). They live inside <Directory> so
    # their scope is our document tree, not the whole server (matters on the
    # keep-apache path). With nothing to set, the line vanishes.
%SETENV%
</Directory>
::END

::Requires "InstallHelpers.cls"