  -- Load the page factory
 .context~package~loadPackage( .request~RexxHTTP_DIR"/apps/page.cls" )

  -- This servlet can be called in two different ways: when called directly,
  -- it prints help about itself; when called indirectly, using an Apache
  -- Action, it serves a source file -- highlighted when the Rexx Parser is
  -- installed, and as plain text otherwise.

  ------------------------------------------------------------------------------
  -- Direct request? Print some help and exit                                 --
  ------------------------------------------------------------------------------

  If .request~handler \== "src-viewer" Then Do
   .response~content_type = "text/html; charset=utf-8"
   .Page~new("RexxHTTP — the source viewer")~body(.Resources~Help)~done
    Exit
  End

  ------------------------------------------------------------------------------
  -- Ok, we've been called as a handler:                                      --
  --                                                                          --
  --   Action src-viewer /src-viewer/index.rxl                                --
  --                                                                          --
  -- and wired to source extensions -- .rex, .orx, .cls, ... -- but NOT to    --
  -- .rxl: a .rxl is a rexxlet, handled (and run) by RexxHTTP itself, never   --
  -- served as source through here.                                           --
  ------------------------------------------------------------------------------

  parserBin = .request~REXX_PARSER
  If parserBin == "" Then
    parserAvailable = .False
  Else
    parserAvailable = SysFileExists(parserBin"/Rexx.Parser.cls")

  If \ parserAvailable Then Do
   .response~content_type = "text/plain; charset=utf-8"
    Say .File~readChars(.request~filename)
    Exit
  End

  -- We have the Parser: highlight and emit HTML.
 .response~content_type = "text/html; charset=utf-8"

  source = .File~readLines(.request~filename)

  parserBin = .request~REXX_PARSER
 .context~package~loadPackage( parserBin"/Highlighter.cls" )

  -- Default style is "dark"; the client-side style chooser restyles it.
  options.        = 0
  options.style   = "dark"
  options.mode    = "HTML"

  source = FencedCode( .request~filename, source, "dark" )

  --highlighted = .Highlighter~new( .request~filename, source, options. )~parse

 .Page~new( FileBaseName(.request~filename) )~body( source~makeString )~done

  Exit

--------------------------------------------------------------------------------
-- FileBaseName -- the last path component of a filename, for the page title. --
--------------------------------------------------------------------------------

::Routine FileBaseName
  Use Strict Arg path
  Return .File~new( path )~name

--------------------------------------------------------------------------------

::Resource HELP
<h1>The source viewer</h1>
<p>This endpoint serves program source files in the site as a styled
 HTML page. Request a source file by its normal URL and Apache routes
 it through here.</p>
<h2>How it is wired</h2>
<p>Two lines in the Apache config send source files through this
 rexxlet:</p>
<pre>Action src-viewer /src-viewer/index.rxl
AddHandler src-viewer .rex .orx .cls</pre>
<p>With the <a href="https://rexx.epbcn.com/rexx-parser/">Rexx
 Parser</a> present the source is highlighted; without it, the raw
 file is served as UTF-8 plain text. The source is always served
 either way.</p>
<p>Note that <code>.rxl</code> files are <em>not</em> wired here: a
 rexxlet is run by RexxHTTP, not shown as source.</p>
::END
